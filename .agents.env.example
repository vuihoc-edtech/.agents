# Cấu hình skill riêng cho từng dự án Flutter.
# Copy file này thành `.agents.env` ở root của dự án Flutter rồi chỉnh giá trị ở đó.
# Không đặt secret/token/password trong `.agents.env`; file này thường không nên commit.

# FLUTTER_ARCHITECTURE_MODE
# Giá trị hợp lệ:
# - strict: mặc định cho app mới; dùng full kiến trúc từ skill flutter-getx-architecture.
# - incremental: dùng khi áp dụng bộ skill vào app đang tồn tại; giữ convention hiện có, chỉ chỉnh trong phạm vi task.
FLUTTER_ARCHITECTURE_MODE=strict

# FLUTTER_API_STACK
# Giá trị hợp lệ:
# - retrofit_json_result_dart: mặc định cho app mới; dùng retrofit + json_serializable + result_dart.
# - existing: dùng cho app đang tồn tại nếu muốn giữ stack API hiện tại của dự án.
FLUTTER_API_STACK=retrofit_json_result_dart

# FLUTTER_STORAGE_POLICY
# Giá trị hợp lệ:
# - shared_preferences_realm: mặc định cho app mới; dùng shared_preferences cho setting nhỏ, dùng realm cho dữ liệu local có cấu trúc.
# - existing: dùng cho app đang tồn tại nếu muốn giữ lựa chọn storage hiện tại của dự án.
FLUTTER_STORAGE_POLICY=shared_preferences_realm

# FLUTTER_DESIGN_SYSTEM
# Giá trị hợp lệ:
# - create: mặc định cho app mới; nếu thiếu thì tạo design system app-level tối thiểu để phát triển tiếp.
# - existing: dùng cho app đang tồn tại để mở rộng theme/design system hiện có, không tự tạo hệ mới nếu task không cần.
FLUTTER_DESIGN_SYSTEM=create

# FLUTTER_COMPONENT_PROMOTION
# Giá trị hợp lệ:
# - promote_base_primitives: mặc định cho app mới; promote sớm các primitive UI dùng toàn app vào design system.
# - conservative: dùng cho app đang tồn tại; giữ widget trong feature cho tới khi reuse và API đủ ổn định.
FLUTTER_COMPONENT_PROMOTION=promote_base_primitives

# FLUTTER_LOCALIZATION_POLICY
# Giá trị hợp lệ:
# - app_en_arb_arb_translate: mặc định cho app mới; dùng app_en.arb làm source, generate các file ARB ngôn ngữ khác bằng arb_translate.
# - existing: dùng cho app đang tồn tại nếu muốn giữ workflow localization hiện tại của dự án.
FLUTTER_LOCALIZATION_POLICY=app_en_arb_arb_translate

# FLUTTER_ASSET_POLICY
# Giá trị hợp lệ:
# - flutter_gen: mặc định cho app mới; ưu tiên truy cập asset qua generated API của flutter_gen.
# - existing: dùng cho app đang tồn tại nếu muốn giữ cách truy cập asset hiện tại của dự án.
FLUTTER_ASSET_POLICY=flutter_gen
